# Copy to .env and fill in. Never commit .env. Production values: docs/dev/contribute/releasing.md.

# PostgreSQL connection string (`make db` starts this one).
DATABASE_URL=postgres://inventassos:inventassos@localhost:5432/inventassos
# HTTP port the server listens on.
PORT=3000
# Public origin, used in e-mail links. Defaults to http://localhost:$PORT outside production.
# APP_URL=https://inv.collecti-frog.fr
# Signs the session cookie. At least 32 characters; generate with `openssl rand -base64 48`.
# This placeholder is refused when NODE_ENV=production.
SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Comma-separated e-mails that become platform admins at first sign-in. Read at startup.
PLATFORM_ADMIN_EMAILS=admin@example.org
# SMTP server. Unset: e-mails are written to the server log. Mailpit (`make db`): smtp://localhost:1025
# SMTP_URL=smtp://localhost:1025
# Behind a proxy that overwrites X-Forwarded-For (the cluster ingress), set to true so per-client
# rate limits see the visitor's address. Leave unset when clients reach the app directly.
# TRUST_PROXY=true
# Sender of every e-mail.
MAIL_FROM=InventAssos <noreply@collecti-frog.fr>
