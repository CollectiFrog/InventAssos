{
  "name": "inventassos",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "dev:poll": "NODE_ENV=development node scripts/dev-poll.ts",
    "start": "node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "test:a11y": "NODE_ENV=test remix test --type e2e",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && remix doctor"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "remix": "3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "axe-core": "4.14.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  }
}
